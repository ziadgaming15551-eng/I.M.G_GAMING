rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Private player account data. All client writes are blocked.
    match /players/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Public, non-sensitive profile and leaderboard information.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{boardId}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Private achievements and progress.
    match /playerAchievements/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /achievementProgress/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /achievementReceipts/{uid}/items/{eventId} {
      allow read, write: if false;
    }

    // Inventory and legacy milestone boosts.
    match /inventory/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /boosts/{uid}/items/{itemId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Attendance and transaction history.
    match /attendance/{uid}/days/{dayId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /transactions/{uid}/items/{transactionId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Friend requests can only be read by either participant.
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }

    match /friends/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Private notification inbox.
    match /notifications/{uid}/items/{notificationId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Read-only public catalogs.
    match /gameCatalog/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /storeCatalog/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Only active admins can read admin audit logs.
    match /adminLogs/{logId} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    // Admin records, redeem codes, Game Pass data, and all unknown paths
    // are intentionally inaccessible from client SDKs.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
